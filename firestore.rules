rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // رابعة طب — Medical Study Planner Firestore Security Rules
    // Strict Per-User Isolation: Each Google account owns and accesses only their data.
    // =========================================================================

    match /users/{userId} {
      // Direct user document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // All subcollections (study data, curriculum progress, tasks, logs, settings)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

